# Pipecat 示例所需的 API Keys
# 复制此文件为 .env，填入真实的 key

# step1_hello.py 只需要这个
CARTESIA_API_KEY=your_cartesia_api_key_here

# step2_voice_bot.py 三个都需要
DEEPGRAM_API_KEY=your_deepgram_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
CARTESIA_API_KEY=your_cartesia_api_key_here

# step19_modular_openai.py 只需要 OPENAI_API_KEY 一个
# （STT + LLM + TTS 全部用 OpenAI，上面的 OPENAI_API_KEY 就够了）

